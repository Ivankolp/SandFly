<?xml version="1.0" encoding="UTF-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

  <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
      android:fragment="com.google.android.accessibility.talkback.preference.base.TextToSpeechSettingsFragment"
      android:key="@string/pref_tts_settings_key"
      android:title="@string/speech_category_voice"
      android:summary="Синтезатор речи, аудиопоток (мультимедиа/спец.возможности), скорость и языки" />

  <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
      android:fragment="com.google.android.accessibility.talkback.preference.base.SoundAndVibrationFragment"
      android:key="@string/pref_sound_and_vibration_key"
      android:title="@string/title_pref_sound_and_vibration"
      android:summary="Звуковые темы (VoiceOver iOS 18), тактильный отклик и громкость" />

  <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
      android:fragment="com.google.android.accessibility.talkback.preference.base.TalkBackGestureShortcutPreferenceFragment"
      android:key="@string/pref_category_manage_gestures_key"
      android:title="@string/title_pref_category_manage_gestures"
      android:summary="Настройка жестов, скролл без затыков, края экрана и скраб" />

  <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
      android:fragment="com.google.android.accessibility.talkback.preference.base.SmartToolsFragment"
      android:key="pref_smart_tools_screen"
      android:title="@string/title_pref_category_tools"
      android:summary="Распознавание картинок, макросы, скрипты, уведомления и Брайль" />

  <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
      android:fragment="com.google.android.accessibility.talkback.preference.base.SystemSettingsFragment"
      android:key="pref_system_settings_screen"
      android:title="@string/title_pref_category_system"
      android:summary="Рамка фокуса, профили, бэкап, Shizuku, обновления и для разработчиков" />

</PreferenceScreen>
